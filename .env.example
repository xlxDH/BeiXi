VITE_TENCENT_MAP_KEY=your_key
VITE_TENCENT_MAP_SK=your_sk

# Overseas maps: configure a MapTiler public browser key OR a self-hosted style URL.
VITE_MAPTILER_KEY=
# Takes precedence over MapTiler; style, tiles, glyphs and sprites must support CORS.
VITE_OVERSEAS_STYLE_URL=
# Optional extra attribution required by your self-hosted data licence.
VITE_OVERSEAS_ATTRIBUTION=
